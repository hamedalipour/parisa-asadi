# نسخهٔ نمونهٔ متغیرهای محیطی — این فایل را به .env کپی کنید و مقادیر را پر کنید
# (در پوشهٔ ریقهٔ پروژه: copy .env.example .env)
#
# فایل .env هرگز نباید در گیت commit شود (در .gitignore هست).

# آدرس اصلی سایت — در Vercel برای دامنهٔ اصلی این مقدار را ست کنید.
# اگر تنظیم نشود، مقدار پیش‌فرض (parisa-asadi.ir) استفاده می‌شود.
NEXT_PUBLIC_SITE_URL=https://parisa-asadi.ir

# شناسهٔ پذیرندگی زرین‌پال — از پنل zarinpal.com تنظیمات درگاه
# اگر خالی بماند، دکمهٔ «ثبت سفارش» به‌جای درگاه، سفارش را با پیام بله به شمارهٔ کلینیک می‌فرستد
ZARINPAL_MERCHANT_ID=

# کلید امضای سفارش (HMAC) — یک رشتهٔ تصادفی قوی باشد.
# در Vercel: vercel env add ORDER_SECRET
# اگر خالی بماند، از ZARINPAL_MERCHANT_ID استفاده می‌شود.
ORDER_SECRET=

# (اختیاری) ذخیره‌سازی پایدار سفارش‌ها و نوبت‌ها — Upstash Redis
# روی Vercel بدون این مقادیر، سفارش‌ها در فایل موقت ذخیره می‌شوند و ممکن است
# بین دو درخواست از بین بروند (پرداخت با توکن امضاشده همچنان تأیید می‌شود).
#
# راه پیشنهادی: از اینتگریشن رسمی Vercel Marketplace استفاده کنید
# (vercel integration add upstash/upstash-kv) و سپس همین دو متغیر را ست کنید.
# بررسی وضعیت: GET /api/health → { "storage": "redis" | "file" }
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# (اختیاری) ربات بله برای اطلاع‌رسانی فوری سفارش/نوبت به مدیر
# ۱) در بله از @BotFather ربات بسازید و توکن را بگیرید
# ۲) به ربات پیام بدهید، سپس chat_id خود را (از @usermanagebot یا API getUpdates) بگیرید
BALE_BOT_TOKEN=
BALE_CHAT_ID=
